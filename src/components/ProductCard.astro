---
import type { CollectionEntry } from "astro:content"
import { url } from "../lib/url"

interface Props {
  product: CollectionEntry<"products">
}

const { product } = Astro.props
const { title, category, maker, summary, priceLabel, image, customizable } = product.data
---
<article class="product-card">
  <a class="product-card__image" href={url("/products/" + product.id)} aria-label={"View " + title}>
    {image ? (
      <img src={url(image)} alt={title} loading="lazy" />
    ) : (
      <div class:list={["product-placeholder", "product-placeholder--" + category]}>
        <span>{category === "wood" ? "Woodcraft" : "Fiber Arts"}</span>
      </div>
    )}
  </a>
  <div class="product-card__body">
    <div class="product-card__meta">
      <span>{category === "wood" ? "Wood" : "Fiber"}</span>
      <span>by {maker}</span>
    </div>
    <h3><a href={url("/products/" + product.id)}>{title}</a></h3>
    <p>{summary}</p>
    <div class="product-card__footer">
      {priceLabel && <span>{priceLabel}</span>}
      {customizable && <span class="custom-pill">Customizable</span>}
    </div>
  </div>
</article>
