---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About Sweat & Sawdust, a personal woodworking shop log.">
  <p class="eyebrow">The shop</p>
  <h1>About</h1>
  <div class="prose">
    <p>
      Sweat &amp; Sawdust is a personal woodworking log: blog posts about
      builds in progress, project pages that collect notes and lessons
      learned, and a running inventory of the tools and supplies that make
      it all possible.
    </p>
    <p>
      The whole site is a static snapshot of a Git repository. Content is
      written in Markdown, edited offline, and published with a push. No
      database, no CMS — the repository <em>is</em> the database.
    </p>
    <p>Measure twice, cut once.</p>
  </div>
</BaseLayout>
