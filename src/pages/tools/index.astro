---
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolTable from '../../components/ToolTable.vue';

const entries = await getCollection('tools');
const tools = entries.map((t) => ({ id: t.id, ...t.data }));
---

<BaseLayout title="Tools" description="The full tool inventory: owned, wanted, sold, and retired.">
  <p class="eyebrow">Inventory</p>
  <h1>Tools</h1>
  <p>
    Every tool in the shop — and on the wishlist. Browse
    <a href={url('/tools/owned')}>owned</a> or <a href={url('/tools/wanted')}>wanted</a>
    directly, or filter below.
  </p>
  <ToolTable client:load tools={tools} />
</BaseLayout>
