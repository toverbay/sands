---
import BaseLayout from "../layouts/BaseLayout.astro"
import site from "../data/site.json"
---

<BaseLayout
  title="Custom Orders"
  description="Ask about a handmade product, request customization, or start a custom order with MT Wood & Fiber Workshop."
>
  <section class="contact-hero">
    <div>
      <p class="eyebrow">Custom orders & questions</p>
      <h1>Tell us what you have in mind.</h1>
    </div>
    <p>
      Looking for a clapper with a name engraved on it, a box sized for
      something specific, or a sewn or crocheted piece in particular colors?
      Send us the details. We will follow up to talk through options, timing,
      and price before anything is made.
    </p>
  </section>

  <section class="contact-layout">
    <aside class="contact-sidebar">
      <div class="contact-card">
        <p class="eyebrow">Get in touch</p>
        <h2>Prefer to contact us directly?</h2>
        <dl>
          <div>
            <dt>Email</dt>
            <dd><a href={"mailto:" + site.email}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd><a href="tel:+17029636207">{site.phone}</a></dd>
          </div>
          <div>
            <dt>Workshop</dt>
            <dd>Las Vegas, Nevada</dd>
          </div>
        </dl>
      </div>

      <div class="custom-options">
        <p class="eyebrow">Common customizations</p>
        <ul>
          <li>Laser engraving</li>
          <li>Wood inlays</li>
          <li>Epoxy accents</li>
          <li>Custom dimensions</li>
          <li>Fabric & color choices</li>
          <li>Made-to-order variations</li>
        </ul>
      </div>
    </aside>

    <div class="order-form-wrap">
      <div class="form-heading">
        <p class="eyebrow">Start a conversation</p>
        <h2>Custom order request</h2>
        <p>
          This is an inquiry, not a binding order. We will confirm the details
          and quote with you before starting work.
        </p>
      </div>

      <form
        class="order-form"
        action={"https://formsubmit.co/" + site.email}
        method="POST"
        enctype="multipart/form-data"
      >
        <input type="hidden" name="_subject" value="New MT Wood & Fiber custom order inquiry" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value="https://mtwoodandfiber.com/contact/thanks/" />
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="form-honey" />

        <div class="form-grid">
          <label>
            <span>Name *</span>
            <input type="text" name="Name" autocomplete="name" required />
          </label>

          <label>
            <span>Email *</span>
            <input type="email" name="Email" autocomplete="email" required />
          </label>

          <label>
            <span>Phone <small>optional</small></span>
            <input type="tel" name="Phone" autocomplete="tel" />
          </label>

          <label>
            <span>Product or project *</span>
            <select name="Product or project" id="product-select" required>
              <option value="">Choose one…</option>
              <option value="Tailor's & Quilter's Clapper">Tailor's & Quilter's Clapper</option>
              <option value="Wooden Boxes">Wooden Boxes</option>
              <option value="Handbags & Totes">Handbags & Totes</option>
              <option value="Bowl Cozies">Bowl Cozies</option>
              <option value="Crocheted Blankets">Crocheted Blankets</option>
              <option value="Potholders">Potholders</option>
              <option value="Something else">Something else</option>
            </select>
          </label>

          <label>
            <span>Quantity <small>optional</small></span>
            <input type="number" name="Quantity" min="1" step="1" />
          </label>

          <label>
            <span>Needed by <small>optional</small></span>
            <input type="date" name="Needed by" />
          </label>
        </div>

        <label class="form-full">
          <span>What would you like? *</span>
          <textarea
            name="Project details"
            rows="7"
            required
            placeholder="Tell us about size, wood or fabric preferences, colors, engraving text, personalization, or anything else that matters."
          ></textarea>
        </label>

        <label class="form-full">
          <span>Reference image <small>optional · JPG or PNG, up to 10 MB</small></span>
          <input type="file" name="Reference image" accept="image/jpeg,image/png,image/webp" />
        </label>

        <label class="consent-row">
          <input type="checkbox" required />
          <span>
            I understand this form starts a conversation and does not place or
            pay for an order.
          </span>
        </label>

        <div class="form-submit">
          <button class="button button--primary" type="submit">Send request</button>
          <p>
            Please do not send payment-card information or other sensitive
            information through this form.
          </p>
        </div>
      </form>
    </div>
  </section>

  <section class="contact-expectations">
    <div>
      <p class="eyebrow">What happens next?</p>
      <h2>We work out the details together.</h2>
    </div>
    <div class="expectation-grid">
      <article>
        <span>01</span>
        <h3>We review your request</h3>
        <p>We will look at the project, materials, customization, and timing.</p>
      </article>
      <article>
        <span>02</span>
        <h3>We confirm the scope</h3>
        <p>We will contact you with questions, options, and a price before work begins.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Then we make it</h3>
        <p>Once the details are agreed on, your piece goes into the workshop.</p>
      </article>
    </div>
  </section>

  <script is:inline>
    const params = new URLSearchParams(window.location.search)
    const requestedProduct = params.get("product")
    const select = document.getElementById("product-select")

    if (requestedProduct && select instanceof HTMLSelectElement) {
      const match = Array.from(select.options).find(
        (option) => option.value.toLowerCase() === requestedProduct.toLowerCase()
      )

      if (match) {
        select.value = match.value
      } else {
        select.value = "Something else"
      }
    }
  </script>
</BaseLayout>

<style>
  .contact-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.8fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    padding: clamp(4rem, 9vw, 8rem) 0 clamp(3rem, 7vw, 6rem);
    border-bottom: 1px solid var(--line);
  }

  .contact-hero h1 {
    max-width: 11ch;
  }

  .contact-hero > p {
    max-width: 40rem;
    margin-bottom: 1.4rem;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(17rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding: clamp(4rem, 8vw, 7rem) 0;
  }

  .contact-sidebar {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .contact-card,
  .custom-options,
  .order-form-wrap {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.55);
  }

  .contact-card,
  .custom-options {
    padding: clamp(1.4rem, 3vw, 2rem);
  }

  .contact-card h2 {
    font-size: 1.65rem;
  }

  .contact-card dl {
    margin: 1.7rem 0 0;
  }

  .contact-card dl > div + div {
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .contact-card dt {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-card dd {
    margin: 0.25rem 0 0;
    font-weight: 650;
  }

  .contact-card a {
    color: var(--copper-dark);
    text-underline-offset: 0.2em;
  }

  .custom-options ul {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--charcoal);
  }

  .custom-options li + li {
    margin-top: 0.35rem;
  }

  .order-form-wrap {
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow: var(--shadow);
  }

  .form-heading {
    max-width: 43rem;
    margin-bottom: 2rem;
  }

  .form-heading > p:last-child {
    color: var(--muted);
  }

  .order-form {
    display: grid;
    gap: 1.2rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .order-form label {
    display: grid;
    gap: 0.45rem;
    font-weight: 650;
  }

  .order-form label > span small {
    color: var(--muted);
    font-weight: 500;
  }

  .order-form input,
  .order-form select,
  .order-form textarea {
    width: 100%;
    min-height: 2.9rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid #cfc1b4;
    border-radius: 10px;
    background: var(--white);
    color: var(--ink);
    font: inherit;
  }

  .order-form textarea {
    min-height: 10rem;
    resize: vertical;
  }

  .order-form input:focus,
  .order-form select:focus,
  .order-form textarea:focus {
    outline: 3px solid color-mix(in srgb, var(--copper) 24%, transparent);
    border-color: var(--copper-dark);
  }

  .form-full {
    grid-column: 1 / -1;
  }

  .consent-row {
    grid-template-columns: auto 1fr !important;
    align-items: start;
    gap: 0.65rem !important;
    color: var(--charcoal);
    font-weight: 500 !important;
  }

  .consent-row input {
    width: 1.1rem;
    height: 1.1rem;
    min-height: 0;
    margin-top: 0.2rem;
  }

  .form-submit {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 0.5rem;
  }

  .form-submit p {
    max-width: 32rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .form-honey {
    position: absolute !important;
    left: -10000px !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden;
  }

  .contact-expectations {
    padding: clamp(3rem, 7vw, 6rem) 0;
    border-top: 1px solid var(--line);
  }

  .contact-expectations > div:first-child {
    max-width: 43rem;
    margin-bottom: 2rem;
  }

  .expectation-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .expectation-grid article {
    padding: 1.4rem;
    border-radius: var(--radius);
    background: var(--paper);
    border: 1px solid var(--line);
  }

  .expectation-grid article > span {
    display: inline-block;
    margin-bottom: 2.2rem;
    color: var(--copper);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .expectation-grid p {
    margin-bottom: 0;
    color: var(--muted);
  }

  @media (max-width: 850px) {
    .contact-hero,
    .contact-layout {
      grid-template-columns: 1fr;
    }

    .expectation-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
