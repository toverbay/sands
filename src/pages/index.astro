---
import { getCollection } from "astro:content"
import BaseLayout from "../layouts/BaseLayout.astro"
import ProductCard from "../components/ProductCard.astro"
import site from "../data/site.json"
import { url } from "../lib/url"

const featured = (await getCollection("products"))
  .filter((product) => product.data.featured && product.data.available)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 4)
---
<BaseLayout>
  <section class="hero">
    <div class="hero__logo">
      <img
        src={url("/images/brand/mt_wood_and_fiber.svg")}
        alt="MT Wood & Fiber Workshop"
        width="560"
        height="534"
      />
    </div>
    <div class="hero__copy">
      <p class="eyebrow">Wood · Sewing · Crochet</p>
      <h1>{site.title}</h1>
      <p class="hero__tagline">{site.tagline}</p>
      <p>{site.heroText}</p>
      <div class="button-row">
        <a class="button button--primary" href={url("/products")}>See our products</a>
        <a class="button button--ghost" href={url("/about")}>Meet the makers</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Two sides of one workshop</p>
      <h2>Wood & fiber, made together.</h2>
      <p>
        Different materials, same goal: thoughtful handmade pieces that feel
        good to use, give, personalize, and keep.
      </p>
    </div>
    <div class="craft-grid">
      <article class="craft-panel craft-panel--wood">
        <span class="craft-panel__number">01</span>
        <h3>Woodworking</h3>
        <p>
          Clappers, boxes, and small woodcraft made with attention to material,
          joinery, finish, and the details that make each piece its own.
        </p>
      </article>
      <article class="craft-panel craft-panel--fiber">
        <span class="craft-panel__number">02</span>
        <h3>Sewing & crochet</h3>
        <p>
          Handbags, blankets, bowl cozies, potholders, and other practical fiber
          goods made for everyday use and gifting.
        </p>
      </article>
    </div>
  </section>

  <section class="section section--bordered">
    <div class="section-heading section-heading--row">
      <div>
        <p class="eyebrow">From the workshop</p>
        <h2>Featured products</h2>
      </div>
      <a class="text-link" href={url("/products")}>View all products →</a>
    </div>
    <div class="product-grid">{featured.map((product) => <ProductCard product={product} />)}</div>
  </section>

  <section class="custom-section">
    <div>
      <p class="eyebrow">Make it yours</p>
      <h2>Customization is part of what we do.</h2>
    </div>
    <p>{site.customization}</p>
  </section>
</BaseLayout>
