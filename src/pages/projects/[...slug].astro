---
import { getCollection, render } from 'astro:content';
import { url } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, status, startedDate, completedDate, tags, toolsUsed, suppliesUsed, relatedPosts, summary } = project.data;

const allTools = await getCollection('tools');
const allSupplies = await getCollection('supplies');
const allPosts = await getCollection('blog');

const toolLinks = toolsUsed.map((id) => ({
  id,
  entry: allTools.find((t) => t.id === id),
}));
const supplyLinks = suppliesUsed.map((id) => ({
  id,
  entry: allSupplies.find((s) => s.id === id),
}));
const postLinks = relatedPosts
  .map((id) => allPosts.find((p) => p.id === id))
  .filter((p) => p !== undefined);
---

<BaseLayout title={title} description={summary}>
  <article class="prose">
    <p class="meta-line">
      <span class={`badge badge--${status}`}>{status}</span>
      {startedDate && <> started {startedDate.toISOString().slice(0, 10)}</>}
      {completedDate && <> / completed {completedDate.toISOString().slice(0, 10)}</>}
    </p>
    <h1>{title}</h1>
    <Content />

    {(toolLinks.length > 0 || supplyLinks.length > 0) && <h2>Used in this build</h2>}
    {toolLinks.length > 0 && (
      <p>
        <strong>Tools:</strong>{' '}
        {toolLinks.map((t, i) => (
          <>
            {i > 0 && ', '}
            {t.entry ? <a href={url(`/tools/${t.id}`)}>{t.entry.data.name}</a> : t.id}
          </>
        ))}
      </p>
    )}
    {supplyLinks.length > 0 && (
      <p>
        <strong>Supplies:</strong>{' '}
        {supplyLinks.map((s, i) => (
          <>
            {i > 0 && ', '}
            {s.entry ? <a href={url(`/supplies/${s.id}`)}>{s.entry.data.name}</a> : s.id}
          </>
        ))}
      </p>
    )}

    {postLinks.length > 0 && (
      <>
        <h2>Related posts</h2>
        <ul>
          {postLinks.map((p) => (
            <li><a href={url(`/blog/${p.id}`)}>{p.data.title}</a></li>
          ))}
        </ul>
      </>
    )}

    {tags.length > 0 && (
      <ul class="pill-row">
        {tags.map((t) => <li class="pill">{t}</li>)}
      </ul>
    )}
  </article>
</BaseLayout>
